<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainProject"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".ProjectActivity">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/projectHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Navigation Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="4dp"
                android:src="@drawable/ic_back" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Avatars dummy & Invite -->
            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_tag"
                android:backgroundTint="#DBEAFE"
                android:gravity="center"
                android:text="JD"
                android:textColor="@color/primary_blue"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="-6dp"
                android:background="@drawable/bg_tag"
                android:backgroundTint="#F5F3FF"
                android:gravity="center"
                android:text="DA"
                android:textColor="#7C3AED"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="-6dp"
                android:background="@drawable/bg_tag"
                android:backgroundTint="#ECFDF5"
                android:gravity="center"
                android:text="MK"
                android:textColor="#059669"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnInviteHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_rounded_button"
                android:backgroundTint="@color/primary_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Invite"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tag Label -->
        <TextView
            android:id="@+id/tvProjectHeaderTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tag"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/tag_ui_text"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="User Interface" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvProjectHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Service Page Website" />

        <!-- TabLayout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@color/white"
            app:tabIndicatorColor="@color/primary_blue"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/primary_blue"
            app:tabTextAppearance="@style/TextAppearance.Material3.LabelLarge"
            app:tabTextColor="@color/text_secondary" />
    </LinearLayout>

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAddTaskContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/projectHeader" />

    <!-- Add Task Bottom Bar Button -->
    <FrameLayout
        android:id="@+id/btnAddTaskContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTask"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/primary_blue"
            android:text="+ Add Task"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>