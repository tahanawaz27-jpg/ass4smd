<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- File Type Icon -->
        <ImageView
            android:id="@+id/ivFileIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tag"
            android:backgroundTint="#EFF6FF"
            android:contentDescription="File Icon"
            android:padding="8dp"
            android:src="@drawable/ic_document" />

        <!-- File Name and Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="sports-projectv2.fig" />

            <TextView
                android:id="@+id/tvFileInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="Image • 2.4 MB • Link" />
        </LinearLayout>

        <!-- Preview Button -->
        <TextView
            android:id="@+id/btnPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="Preview"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Remove Icon -->
        <ImageView
            android:id="@+id/btnRemoveAttachment"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove Attachment"
            android:padding="4dp"
            android:src="@drawable/ic_trash" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>